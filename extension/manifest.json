{
  "manifest_version": 3,
  "name": "OnDevice Browser Agent",
  "version": "0.1.0",
  "description": "Privacy-preserving on-device browser automation agent.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:5000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["privacyFilter.js", "browserActions.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  }
}
